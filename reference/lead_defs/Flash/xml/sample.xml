	</Label>	
		
	<ListView
		Name="listview1"
		PosX="40"
		PosY="300"		
		Width="300"
		Height="200"
		SelectedIndex="0"
	>
	
		<Tweens>
		
			<Tween
				Property="RotationX"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="500"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="2000"
			/>
			
			<Tween
				Property="RotationY"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="4000"
			/>
		
		</Tweens>
		
		<Items>
		
			<Item Text="Item 1">
			
				<Item Text="Sub 1">
		
					<Item Text="Sub 2"/>
				
				</Item>
				
			</Item>
			
			<Item Text="Item 2">
				
				<Item Text="Sub 1" />
				
			</Item>
		
		<Item Text="Item 3"/>
		
		</Items>
		
		<Columns>
		
			<Column Width="100"/>
			<Column Width="100"/>
			<Column Width="100"/>
		
		</Columns>
		
		<OnSelectedIndexChanged>
		
			<CommandTween
				Property="rotationy"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
		</OnSelectedIndexChanged>
		
