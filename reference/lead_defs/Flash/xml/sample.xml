		Asset="SpinnerSample"
		Name="spinnergeneric1"
		PosX="600"
		PosY="500"
	/>
	
	<TimerGeneric
		Asset="TimerSample"
		TimerFrameCount="100"
		Name="timergeneric1"
		PosX="800"
		PosY="500"
		Text=""
		DurationMs="2000"
	>
	
		<OnTimerFinished>
		
			<CommandTween
				Target="_PARENT.dropdown1"
				Property="RotationY"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
		</OnTimerFinished>
		
	</TimerGeneric>
	
