<?xml version="1.0" encoding="UTF-8" ?>
<root>

	<FocusTransfer
		Default="button1"
	>
	
		<Item
			Source="button1"
			Transfer="down"
			Target="button2"
			Reverse="1"
		/>
		
		<Item
			Source="button2"
			Transfer="down"
			Target="button3"
			Reverse="1"
		/>
		
		<Item
			Source="button3"
			Transfer="down"
			Target="button4"
			Reverse="1"
		/>
		
		<Item
			Source="button4"
			Transfer="down"
			Target="listview1"
			Reverse="1"
		/>
		
		<Item
			Source="listview1"
			Transfer="down"
			Target="dropdown1"
			Reverse="1"
		/>
		
		<Item
			Source="dropdown1"
			Transfer="down"
			Target="label2.button5"
			Reverse="1"
		/>
		
		<Item
			Source="label2.button5"
			Transfer="down"
			Target="label2.button6"
			Reverse="1"
		/>
		
		<Item
			Source="label2.button6"
			Transfer="down"
			Target="button1"
			Reverse="1"
		/>
	
	</FocusTransfer>
	
	<Button
		Name="button1"
		PosX="50"
		PosY="50"
		Text="Button 1"
		Alpha="50"
		BlurX="1.5"
		BlurY="1.7"
		ScaleX="100"
		ScaleY="100"
		Visible="1"
		RotationX="0"
		RotationY="0"
		RotationZ="0"
		State="up"
	>
	
		<Tweens>
		
			<Tween
				Property="RotationX"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="2000"
			/>
		
		</Tweens>
		
		<OnSelectPressed>
		
			<Command
				Target="_PARENT"
				Param1="StartTimer"
			/>
			
			<CommandTween
				Target="_PARENT.listview1"
				Property="RotationZ"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
		</OnSelectPressed>
		
		<OnCancelPressed/>		
		<OnStartPressed/>		
		<OnBackPressed/>
		<OnButtonXPressed/>
		<OnButtonYPressed/>
		<OnDPadUpPressed/>
		<OnDPadDownPressed/>
		<OnGainFocus/>
		<OnLoseFocus/>
		<OnLeftBumperPressed/>
		<OnRightBumperPressed/>
		<OnLeftTriggerPressed/>
		<OnRightTriggerPressed/>
		<OnUserSelection/>
		<OnValueChanged/>
		
	</Button>
	
	<Button
		Name="button2"
		PosX="50"
		PosY="100"
		Text="Button 2"
		Alpha="50"
		BlurX="1.5"
		BlurY="1.7"
		ScaleX="100"
		ScaleY="100"
		Visible="1"
		RotationX="0"
		RotationY="0"
		RotationZ="0"
		State="up"
	>
	
		<OnSelectPressed>
		
			<Command
				Target="_PARENT"
				Param1="ToggleSpinner"
			/>
			
		</OnSelectPressed>
		
	</Button>
	
	<Button
		Name="button3"
		PosX="50"
		PosY="150"
		Text="Button 3"
		Alpha="50"
		BlurX="1.5"
		BlurY="1.7"
		ScaleX="100"
		ScaleY="100"
		Visible="1"
		RotationX="0"
		RotationY="0"
		RotationZ="0"
		State="up"
	>
	
		<OnSelectPressed>
		
			<Command
				Target="_PARENT"
				Param1="StepProgress"
			/>
			
			<CommandTween
				Target="_PARENT.label1"
				Property="PosX"
				InitialValue="1000"
				TargetValue="500"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
