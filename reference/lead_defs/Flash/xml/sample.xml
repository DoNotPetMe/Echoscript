				Target="_PARENT.button2"
				Property="RotationZ"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="1000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
			<CommandTween
				Target="_PARENT.button3"
				Property="RotationZ"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="1000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
			<CommandTween
				Target="_PARENT.button4"
				Property="RotationZ"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="1000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
		</OnSelectPressed>
		
