			<Tween
				Property="PosX"
				InitialValue="500"
				TargetValue="1000"
				Milliseconds="2000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="2000"
			/>
			
			<Tween
				Property="RotationZ"
