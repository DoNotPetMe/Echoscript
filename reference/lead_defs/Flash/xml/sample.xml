			<CommandTween
				Target="_PARENT.button1"
				Property="RotationZ"
				InitialValue="0"
				TargetValue="360"
				Milliseconds="1000"
				Equation="EaseIn"
				Transition="Sine"
				DelayMs="0"
			/>
			
