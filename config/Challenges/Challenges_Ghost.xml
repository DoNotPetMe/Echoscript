  <!-- Security Systems : Temporarily disable [n] security systems with EMP gadgets while remaining undetected for [x] seconds after each -->
  <Challenge Name="LocId_SNN_OD_EMPSecuritySystems" Desc="LocId_SNDES_OD_EMPSecuritySystemsDesc" Reset="Never" Guid="123" ShortDesc="LocId_SNSD_OD_EMPSecuritySystems" Category="ChallengeGhost" Icon="ghost" Map="G_RAND">
    <Definition>
      <GameEvent>
        <ClassComponent Name="Echelon.ECustomChallenge_MapScoringEnabled" Op="Equal" Gate="true" />
        <ClassComponent Name="Echelon.ECustomChallenge_Detection" Op="Not" Gate="true" />
        <DelayComponent Duration="3.0" />
        <Event>
          <GameItemHitByEMP>
            <GameItem Op="Equal">
              <Value>Laser</Value>
              <Value>Camera</Value>
              <Value>PowerBox</Value>
              <Value>MotionDetector</Value>
            </GameItem>
            <IsInstigatorLocalPlayer Op="Equal" Value="true" />
            <IsAdversarial Op="Equal" Value="false" />
          </GameItemHitByEMP>
        </Event>
      </GameEvent>
    </Definition>
    <StepReward Count="5">
      <Economy ValueTag="StandardTier1" />
    </StepReward>
    <StepReward Count="20">
      <Economy ValueTag="StandardTier2" />
    </StepReward>
    <StepReward Count="50">
      <Economy ValueTag="StandardTier3" />
    </StepReward>
  </Challenge>  
