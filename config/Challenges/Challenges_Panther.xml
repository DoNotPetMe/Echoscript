  <!-- Mark & Execute OTM : Perform [n] successful Execute actions in motion and successfully avoid detection (ALKP, or taking damage) within [x] seconds after -->
  <Challenge Name="LocId_SNN_OD_MAEInMotionUndetected" Desc="LocId_SNDES_OD_MAEInMotionUndetectedDesc" Reset="Never" Guid="184" ShortDesc="LocId_SNSD_OD_MAEInMotionUndetected" Category="ChallengePanther" Icon="panther" Map="H_RAND">
    <Definition>
      <GameEvent>
        <ClassComponent Name="Echelon.ECustomChallenge_MapScoringEnabled" Op="Equal" Gate="true" />
        <ClassComponent Name="Echelon.ECustomChallenge_Detection" Op="Not" Gate="true" />
        <DelayComponent Duration="3.0" />
        <Event>
          <MAEPawnExecuted>
            <IsTargetAnyNPC Op="Equal" Value="true" />
            <IsPlayerLocal Op="Equal" Value="true" />            
            <IsSuccessful Op="Equal" Value="true" />
            <IsInMotion Op="Equal" Value="true" />
          </MAEPawnExecuted>
        </Event>
      </GameEvent>
    </Definition>
    <StepReward Count="5">
      <Economy ValueTag="StandardTier1" />
    </StepReward>
    <StepReward Count="15">
      <Economy ValueTag="StandardTier2" />
    </StepReward>
    <StepReward Count="40">
      <Economy ValueTag="StandardTier3" />
    </StepReward>
  </Challenge>
