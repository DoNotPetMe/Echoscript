  <!-- Score : Partner up to and score [n] points in a COOP campaign -->
  <Challenge Name="LocId_SNN_OD_LargeCoopScore" Desc="LocId_SNDES_OD_LargeCoopScoreDesc" Reset="Never" Guid="100" ShortDesc="LocId_SNSD_OD_LargeCoopScore" Category="ChallengeCoop" Icon="ghost" Map="COOP_RAND" SequenceRequirement="13000">
    <Definition>
      <GameEvent>
        <Event>
          <MissionCompleted>
            <SC6MissionName Op="Equal">
              <Value>C01</Value>
              <Value>C02</Value>
              <Value>C03</Value>
              <Value>C04</Value>
              <Value>E01</Value>
              <Value>E02</Value>
              <Value>E03</Value>
              <Value>E04</Value>
              <Value>G01</Value>
              <Value>G02</Value>
              <Value>G03</Value>
              <Value>G04</Value>
              <Value>H01</Value>
              <Value>H02</Value>
              <Value>H03</Value>
              <Value>H04</Value>
            </SC6MissionName>
            <Success Op="Equal" Value="true" />
            <WithCoopPartner Op="Equal" Value="true" />
            <TotalScore Op="GreaterOrEqual" Value="13000" />
          </MissionCompleted>
        </Event>
      </GameEvent>
    </Definition>
    <StepReward Count="1">
      <Economy ValueTag="CoopScoreLarge" />
    </StepReward>
  </Challenge>
